{
  "name": "10tracker-youtube-progress",
  "version": "1.2.2",
  "private": true,
  "description": "Sync YouTube watch progress for 10tracker OG Tracker path videos",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build",
    "build:firefox": "vite build --config vite.firefox.config.js",
    "preview": "vite build --watch"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "vite": "^5.4.11"
  }
}
